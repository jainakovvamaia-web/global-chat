# Скопируйте этот файл в .env (в папке chat-beck) и заполните значения.
# На хостинге (Render / Railway / Fly.io) эти же переменные задаются в настройках сервиса.
# Файл .env в git не попадает (.gitignore).

# Порт. Хостинг обычно задаёт его сам — тогда не указывайте.
PORT=5000

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# СЕКРЕТНЫЙ ключ: полный доступ к базе. Только на сервере, никогда во frontend и в git.
SUPABASE_SERVICE_ROLE_KEY=

# Адрес(а) frontend — для CORS, проверки Origin у WebSocket и ссылок в письмах.
# Несколько адресов — через запятую; первый используется в ссылках из писем.
# Пример: https://your-app.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Секрет для анонимных id участников (случайная строка от 32 символов). Не меняйте после запуска.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMBER_ID_SECRET=

# Необязательно: ключ Claude API для AI-помощника.
ANTHROPIC_API_KEY=
